<% const isCancelled = appointment.status === "cancelled"; %>
<li class="card gap-3 <%= isCancelled ? "bg-slate-50 opacity-70 shadow-none" : "" %>">
  <div class="flex items-start justify-between gap-3">
    <div class="flex min-w-0 flex-1 flex-wrap items-center gap-2">
      <a
        href="/therapists/<%= appointment.therapist.id %>"
        class="font-semibold text-slate-900 hover:text-teal-700 hover:underline <%= isCancelled ? "line-through" : "" %>"
      >
        <%= appointment.therapist.avatarEmoji %> <%= appointment.therapist.name %>
      </a>
      <%- include("../_status-badge", { status: appointment.status }) %>
    </div>
    <a href="/appointments/<%= appointment.id %>" class="link shrink-0 text-sm">View &rarr;</a>
  </div>

  <p class="text-sm text-slate-600 <%= isCancelled ? "line-through" : "" %>">
    <%= appointment.requestedAtLabel %>
  </p>

  <p class="text-sm">
    <% if (appointment.therapy) { %>
      <span class="text-slate-500">Prescribed:</span>
      <span class="font-medium text-slate-900"><%= appointment.therapy.icon %> <%= appointment.therapy.name %></span>
    <% } else { %>
      <span class="text-slate-500">Not yet prescribed</span>
    <% } %>
  </p>

  <% if (rowError && rowError.appointmentId === appointment.id) { %>
    <p class="alert-error" role="alert"><%= rowError.message %></p>
  <% } %>

  <% if (appointment.canManage) { %>
    <div class="flex flex-col gap-2 border-t border-slate-100 pt-3 sm:flex-row sm:items-center">
      <form method="POST" action="/appointments/<%= appointment.id %>/reschedule" class="flex flex-1 flex-col gap-2 sm:flex-row sm:items-center">
        <input type="hidden" name="returnTo" value="/appointments" />
        <input
          type="datetime-local"
          name="requestedAt"
          aria-label="New time"
          value="<%= (rescheduleForm && rescheduleForm.appointmentId === appointment.id) ? (rescheduleForm.requestedAt ?? "") : appointment.rescheduleValue %>"
          class="input py-1.5 sm:w-auto"
        />
        <button type="submit" class="btn btn-secondary btn-sm self-start sm:self-auto">Reschedule</button>
      </form>

      <form method="POST" action="/appointments/<%= appointment.id %>/cancel">
        <input type="hidden" name="returnTo" value="/appointments" />
        <button type="submit" class="btn btn-danger btn-sm">Cancel</button>
      </form>
    </div>
  <% } %>
</li>
