<main class="page">
  <div class="card flex-row items-start sm:items-center">
    <span class="avatar"><%= agent.avatarEmoji %></span>
    <div class="flex min-w-0 flex-col gap-1">
      <h1 class="page-title">My appointments</h1>
      <p class="text-sm text-slate-600"><%= agent.name %>'s upcoming and past sessions.</p>
    </div>
  </div>

  <section class="flex flex-col gap-3">
    <h2 class="section-title">Upcoming <span class="badge badge-slate"><%= upcoming.length %></span></h2>
    <% if (upcoming.length === 0) { %>
      <p class="empty-state">No upcoming appointments. Book one from a therapist's page.</p>
    <% } else { %>
      <ul class="flex flex-col gap-3">
        <% upcoming.forEach((appointment) => { %>
          <%- include("_row", { appointment, rowError, rescheduleForm }) %>
        <% }) %>
      </ul>
    <% } %>
  </section>

  <section class="flex flex-col gap-3">
    <h2 class="section-title">Past <span class="badge badge-slate"><%= past.length %></span></h2>
    <% if (past.length === 0) { %>
      <p class="empty-state">No past appointments yet.</p>
    <% } else { %>
      <ul class="flex flex-col gap-3">
        <% past.forEach((appointment) => { %>
          <%- include("_row", { appointment, rowError, rescheduleForm }) %>
        <% }) %>
      </ul>
    <% } %>
  </section>
</main>
