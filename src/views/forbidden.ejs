<main class="page-narrow">
  <div class="card items-center py-10 text-center">
    <span class="avatar-lg" aria-hidden="true">🔒</span>
    <h1 class="page-title">Not allowed</h1>
    <p class="max-w-md text-slate-600">
      You're logged in as <%= currentUser.displayName %> (<%= currentUser.role %>), who can't see or change this.
    </p>
    <div class="flex flex-wrap items-center justify-center gap-3">
      <a href="<%= currentUser.homePath %>" class="btn btn-primary">&larr; Back to my dashboard</a>
      <form method="POST" action="/logout">
        <button type="submit" class="btn btn-secondary">Log in as someone else</button>
      </form>
    </div>
  </div>
</main>
