<main class="mx-auto flex max-w-xl flex-col items-center gap-4 px-4 py-24 text-center">
  <h1 class="text-2xl font-bold tracking-tight text-slate-900">Not allowed</h1>
  <p class="text-slate-600">
    You're logged in as <%= currentUser.displayName %> (<%= currentUser.role %>), who can't see or change this.
  </p>
  <div class="flex flex-wrap items-center justify-center gap-4">
    <a href="<%= currentUser.homePath %>" class="text-teal-700 hover:underline">&larr; Back to my dashboard</a>
    <form method="POST" action="/logout">
      <button type="submit" class="text-teal-700 hover:underline">Log in as someone else</button>
    </form>
  </div>
</main>
