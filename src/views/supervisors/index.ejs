<main class="mx-auto flex max-w-3xl flex-col gap-6 px-4 py-16">
  <a href="/" class="text-sm text-teal-700 hover:underline">&larr; Back home</a>

  <div class="flex flex-col gap-2 text-center">
    <h1 class="text-3xl font-bold tracking-tight text-teal-700">Supervisors</h1>
    <p class="text-slate-600">Check in on the agents you supervise.</p>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <% supervisors.forEach((supervisor) => { %>
      <a
        href="/supervisors/<%= supervisor.id %>"
        class="flex items-start gap-4 rounded-lg border border-slate-200 bg-white px-5 py-4 shadow-sm transition hover:border-teal-300 hover:shadow-md"
      >
        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-teal-50 text-2xl">
          <%= supervisor.avatarEmoji %>
        </span>
        <span class="flex flex-col gap-1">
          <span class="font-semibold text-slate-900"><%= supervisor.name %></span>
          <span class="text-sm text-slate-500">
            <%= supervisor.agentCount %> agent<%= supervisor.agentCount === 1 ? "" : "s" %> supervised
          </span>
        </span>
      </a>
    <% }) %>
  </div>
</main>
