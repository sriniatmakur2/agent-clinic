<main class="page gap-8">
  <div class="card flex-row items-start sm:items-center">
    <span class="avatar"><%= supervisor.avatarEmoji %></span>
    <div class="flex min-w-0 flex-col gap-1">
      <h1 class="page-title"><%= supervisor.name %>'s team</h1>
      <p class="text-sm text-pretty text-slate-600"><%= supervisor.bio %></p>
    </div>
  </div>

  <% if (agentSections.length === 0) { %>
    <p class="empty-state">No agents are assigned to this supervisor yet.</p>
  <% } else { %>
    <% agentSections.forEach((section) => { %>
      <section class="card gap-5">
        <div class="flex items-center gap-3">
          <span class="avatar h-10 w-10 text-xl"><%= section.agent.avatarEmoji %></span>
          <h2 class="section-title">
            <a href="/agents/<%= section.agent.id %>" class="hover:text-teal-700 hover:underline"><%= section.agent.name %></a>
          </h2>
        </div>

        <div class="flex flex-col gap-2">
          <h3 class="text-sm font-semibold text-slate-700">Reported ailments</h3>
          <% if (section.ailments.length === 0) { %>
            <p class="text-sm text-slate-500">No ailments reported.</p>
          <% } else { %>
            <div class="flex flex-wrap gap-1.5">
              <% section.ailments.forEach((ailment) => { %>
                <span class="badge badge-slate"><%= ailment.name %></span>
              <% }) %>
            </div>
          <% } %>
        </div>

        <div class="flex flex-col gap-3">
          <h3 class="flex items-center gap-2 text-sm font-semibold text-slate-700">
            Upcoming appointments <span class="badge badge-slate"><%= section.upcoming.length %></span>
          </h3>
          <% if (section.upcoming.length === 0) { %>
            <p class="empty-state py-4">No upcoming appointments.</p>
          <% } else { %>
            <ul class="flex flex-col gap-3">
              <% section.upcoming.forEach((appointment) => { %>
                <%- include("../appointments/_row", { appointment, rowError: null, rescheduleForm: null }) %>
              <% }) %>
            </ul>
          <% } %>
        </div>

        <div class="flex flex-col gap-3">
          <h3 class="flex items-center gap-2 text-sm font-semibold text-slate-700">
            Past appointments <span class="badge badge-slate"><%= section.past.length %></span>
          </h3>
          <% if (section.past.length === 0) { %>
            <p class="empty-state py-4">No past appointments.</p>
          <% } else { %>
            <ul class="flex flex-col gap-3">
              <% section.past.forEach((appointment) => { %>
                <%- include("../appointments/_row", { appointment, rowError: null, rescheduleForm: null }) %>
              <% }) %>
            </ul>
          <% } %>
        </div>
      </section>
    <% }) %>
  <% } %>
</main>
