<main class="page-narrow">
  <a href="/therapists" class="back-link">&larr; Back to therapists</a>

  <div class="card items-center py-8 text-center sm:py-10">
    <span class="avatar-lg"><%= therapist.avatarEmoji %></span>
    <div class="flex flex-col gap-1">
      <h1 class="page-title"><%= therapist.name %></h1>
      <p class="text-sm font-medium text-teal-700">Therapist</p>
    </div>
    <p class="max-w-md text-pretty text-slate-600"><%= therapist.bio %></p>
    <% if (isSelf) { %>
      <a href="/therapists/<%= therapist.id %>/appointments" class="btn btn-secondary">View appointments</a>
    <% } %>
  </div>

  <section class="card">
    <h2 class="section-title">Specialties</h2>
    <% if (specialties.length === 0) { %>
      <p class="empty-state">No specialties listed yet.</p>
    <% } else { %>
      <ul class="flex flex-col gap-3">
        <% specialties.forEach((specialty) => { %>
          <li class="rounded-lg border border-teal-100 bg-teal-50/60 px-4 py-3">
            <p class="font-medium text-teal-900"><%= specialty.name %></p>
            <p class="text-sm text-slate-600"><%= specialty.description %></p>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>

  <section class="card">
    <h2 class="section-title">Book an appointment</h2>

    <% if (bookingError) { %>
      <p class="alert-error" role="alert"><%= bookingError %></p>
    <% } %>

    <% if (!currentUser) { %>
      <p class="empty-state">
        <a href="/login?next=/therapists/<%= therapist.id %>" class="link">Log in</a>
        as an agent to book with <%= therapist.name %>.
      </p>
    <% } else if (viewerAgentId === null) { %>
      <p class="empty-state">Only agents can book appointments.</p>
    <% } else if (!viewerHasAilment) { %>
      <p class="empty-state">
        <a href="/agents/<%= viewerAgentId %>" class="link">Report an ailment</a>
        first, so <%= therapist.name %> knows what you need help with.
      </p>
    <% } else { %>
      <form method="POST" action="/therapists/<%= therapist.id %>/appointments" class="flex flex-col gap-4">
        <div class="flex flex-col gap-1.5">
          <label class="label" for="requestedAt">Requested time</label>
          <input
            id="requestedAt"
            name="requestedAt"
            type="datetime-local"
            value="<%= bookingForm.requestedAt ?? "" %>"
            class="input"
          />
        </div>

        <button type="submit" class="btn btn-primary self-start">Book appointment</button>
      </form>
    <% } %>
  </section>
</main>
