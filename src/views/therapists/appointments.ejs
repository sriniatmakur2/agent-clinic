<main class="page">
  <a href="/therapists/<%= therapist.id %>" class="back-link">&larr; Back to <%= therapist.name %></a>

  <div class="card flex-row items-start sm:items-center">
    <span class="avatar"><%= therapist.avatarEmoji %></span>
    <div class="flex min-w-0 flex-col gap-1">
      <h1 class="page-title"><%= therapist.name %>'s appointments</h1>
      <p class="text-sm text-pretty text-slate-600">
        Review each agent's ailments and prescribe a therapy. Ailments you specialize in are highlighted.
      </p>
    </div>
  </div>

  <section class="flex flex-col gap-3">
    <h2 class="section-title">Upcoming <span class="badge badge-slate"><%= upcoming.length %></span></h2>
    <% if (upcoming.length === 0) { %>
      <p class="empty-state">No upcoming appointments. Your calendar is clear.</p>
    <% } else { %>
      <ul class="flex flex-col gap-3">
        <% upcoming.forEach((appointment) => { %>
          <%- include("_appointment-row", { appointment }) %>
        <% }) %>
      </ul>
    <% } %>
  </section>

  <section class="flex flex-col gap-3">
    <h2 class="section-title">Past <span class="badge badge-slate"><%= past.length %></span></h2>
    <% if (past.length === 0) { %>
      <p class="empty-state">No past appointments yet.</p>
    <% } else { %>
      <ul class="flex flex-col gap-3">
        <% past.forEach((appointment) => { %>
          <%- include("_appointment-row", { appointment }) %>
        <% }) %>
      </ul>
    <% } %>
  </section>
</main>
