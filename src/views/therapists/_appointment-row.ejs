<% const isCancelled = appointment.status === "cancelled"; %>
<li class="card gap-3 sm:flex-row sm:items-start sm:justify-between <%= isCancelled ? "bg-slate-50 opacity-70 shadow-none" : "" %>">
  <div class="flex min-w-0 items-start gap-3">
    <span class="avatar h-10 w-10 text-xl"><%= appointment.agent.avatarEmoji %></span>
    <div class="flex min-w-0 flex-col gap-1.5">
      <div class="flex flex-wrap items-center gap-2">
        <a
          href="/agents/<%= appointment.agent.id %>"
          class="font-semibold text-slate-900 hover:text-teal-700 hover:underline <%= isCancelled ? "line-through" : "" %>"
        >
          <%= appointment.agent.name %>
        </a>
        <%- include("../_status-badge", { status: appointment.status }) %>
      </div>
      <p class="text-sm text-slate-600 <%= isCancelled ? "line-through" : "" %>"><%= appointment.requestedAtLabel %></p>
      <% if (appointment.ailments.length > 0) { %>
        <div class="flex flex-wrap gap-1.5">
          <% appointment.ailments.forEach((ailment) => { %>
            <span
              class="badge <%= ailment.isSpecialty ? "badge-solid" : "badge-slate" %>"
              <%- ailment.isSpecialty ? 'title="One of your specialties"' : "" %>
            ><%= ailment.name %></span>
          <% }) %>
        </div>
      <% } %>
      <p class="text-sm">
        <% if (appointment.therapy) { %>
          <span class="text-slate-500">Prescribed:</span>
          <span class="font-medium text-slate-900"><%= appointment.therapy.icon %> <%= appointment.therapy.name %></span>
        <% } else { %>
          <span class="text-slate-500">Not yet prescribed</span>
        <% } %>
      </p>
    </div>
  </div>
  <a href="/appointments/<%= appointment.id %>" class="btn btn-secondary btn-sm shrink-0 self-start">
    <%= appointment.status === "prescribed" ? "Review / revise" : "Review / prescribe" %>
  </a>
</li>
