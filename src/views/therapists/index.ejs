<main class="page">
  <div class="page-header">
    <h1 class="page-title">Therapists on staff</h1>
    <p class="page-subtitle">Meet the clinicians who help agents feel like themselves again.</p>
  </div>

  <% if (therapists.length === 0) { %>
    <p class="empty-state">No therapists on staff yet.</p>
  <% } else { %>
    <div class="grid gap-4 sm:grid-cols-2">
      <% therapists.forEach((therapist) => { %>
        <a href="/therapists/<%= therapist.id %>" class="card card-link flex-row items-start">
          <span class="avatar"><%= therapist.avatarEmoji %></span>
          <span class="flex min-w-0 flex-col gap-2">
            <span class="font-semibold text-slate-900"><%= therapist.name %></span>
            <% if (therapist.specialties.length > 0) { %>
              <span class="flex flex-wrap gap-1.5">
                <% therapist.specialties.forEach((specialty) => { %>
                  <span class="badge badge-teal"><%= specialty %></span>
                <% }) %>
              </span>
            <% } %>
          </span>
        </a>
      <% }) %>
    </div>
  <% } %>
</main>
