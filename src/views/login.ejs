<main class="page-narrow max-w-md">
  <div class="card">
    <div class="page-header">
      <h1 class="page-title">Log in</h1>
      <p class="text-sm text-slate-600">Pick any demo account below.</p>
    </div>

    <% if (error) { %>
      <p class="alert-error" role="alert"><%= error %></p>
    <% } %>

    <form method="POST" action="/login" class="flex flex-col gap-4">
      <input type="hidden" name="next" value="<%= next %>" />

      <div class="flex flex-col gap-1.5">
        <label class="label" for="username">Username</label>
        <input
          id="username"
          name="username"
          type="text"
          autocomplete="username"
          value="<%= username %>"
          class="input"
        />
      </div>

      <div class="flex flex-col gap-1.5">
        <label class="label" for="password">Password</label>
        <input
          id="password"
          name="password"
          type="password"
          autocomplete="current-password"
          class="input"
        />
      </div>

      <button type="submit" class="btn btn-primary w-full">Log in</button>
    </form>
  </div>

  <div class="flex flex-col gap-2 rounded-xl border border-slate-200 bg-slate-100 px-5 py-4 text-sm text-slate-600">
    <p class="font-semibold text-slate-700">Demo accounts</p>
    <p>Every account's password is <code class="rounded bg-white px-1.5 py-0.5 font-mono text-slate-900"><%= demoPassword %></code>.</p>
    <% demoAccounts.forEach((group) => { %>
      <p>
        <span class="font-medium text-slate-700"><%= group.label %>:</span>
        <span class="font-mono"><%= group.usernames.join(", ") %></span>
      </p>
    <% }) %>
  </div>
</main>
