<main class="page-narrow">
  <a href="/therapies" class="back-link">&larr; Back to therapies</a>

  <div class="card items-center py-8 text-center sm:py-10">
    <span class="avatar-lg"><%= therapy.icon %></span>
    <div class="flex flex-col items-center gap-2">
      <h1 class="page-title"><%= therapy.name %></h1>
      <span class="badge badge-teal"><%= therapy.durationMinutes %> minutes</span>
    </div>
    <p class="max-w-md text-pretty text-slate-600"><%= therapy.description %></p>
  </div>
</main>
