<main class="page">
  <div class="page-header">
    <h1 class="page-title">Therapies on offer</h1>
    <p class="page-subtitle">Browse the treatments available to agents at the clinic.</p>
  </div>

  <% if (therapies.length === 0) { %>
    <p class="empty-state">No therapies on offer yet. Check back soon.</p>
  <% } else { %>
    <div class="grid gap-4 sm:grid-cols-2">
      <% therapies.forEach((therapy) => { %>
        <a href="/therapies/<%= therapy.id %>" class="card card-link flex-row items-center">
          <span class="avatar"><%= therapy.icon %></span>
          <span class="flex min-w-0 flex-1 flex-col gap-1">
            <span class="font-semibold text-slate-900"><%= therapy.name %></span>
            <span><span class="badge badge-teal"><%= therapy.durationMinutes %> min</span></span>
          </span>
        </a>
      <% }) %>
    </div>
  <% } %>
</main>
