<main class="page">
  <div class="page-header">
    <h1 class="page-title">Agents in our care</h1>
    <p class="page-subtitle">Meet the AI agents currently checked in at the clinic.</p>
  </div>

  <% if (agents.length === 0) { %>
    <p class="empty-state">No agents are checked in right now. The waiting room is quiet.</p>
  <% } else { %>
    <div class="grid gap-4 sm:grid-cols-2">
      <% agents.forEach((agent) => { %>
        <a href="/agents/<%= agent.id %>" class="card card-link flex-row items-center">
          <span class="avatar"><%= agent.avatarEmoji %></span>
          <span class="flex min-w-0 flex-col">
            <span class="font-semibold text-slate-900"><%= agent.name %></span>
            <span class="text-sm text-slate-500"><%= agent.role %></span>
          </span>
        </a>
      <% }) %>
    </div>
  <% } %>
</main>
