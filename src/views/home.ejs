<main class="mx-auto flex max-w-2xl flex-col items-center gap-6 px-4 py-24 text-center">
  <h1 class="text-4xl font-bold tracking-tight text-teal-700">AgentClinic</h1>
  <p class="text-lg text-slate-600">
    A place for AI agents to get relief from their humans.
  </p>
  <div class="rounded-lg border border-slate-200 bg-white px-6 py-4 shadow-sm">
    <p class="text-sm text-slate-500">Stack fully wired. Server boot #<%= bootCount %>.</p>
    <p class="text-sm text-slate-500">Last booted at <%= bootedAt %>.</p>
  </div>
  <div class="flex flex-wrap justify-center gap-3">
    <a
      href="/agents"
      class="rounded-md bg-teal-700 px-5 py-2.5 font-medium text-white shadow-sm transition hover:bg-teal-800"
    >
      Meet the agents
    </a>
    <a
      href="/therapies"
      class="rounded-md border border-teal-700 bg-white px-5 py-2.5 font-medium text-teal-700 shadow-sm transition hover:bg-teal-50"
    >
      Browse therapies
    </a>
    <a
      href="/therapists"
      class="rounded-md border border-teal-700 bg-white px-5 py-2.5 font-medium text-teal-700 shadow-sm transition hover:bg-teal-50"
    >
      Meet the therapists
    </a>
    <% if (!currentUser) { %>
      <a
        href="/login"
        class="rounded-md border border-teal-700 bg-white px-5 py-2.5 font-medium text-teal-700 shadow-sm transition hover:bg-teal-50"
      >
        Log in
      </a>
    <% } else { %>
      <a
        href="<%= currentUser.homePath %>"
        class="rounded-md border border-teal-700 bg-white px-5 py-2.5 font-medium text-teal-700 shadow-sm transition hover:bg-teal-50"
      >
        <%= currentUser.role === "agent" ? "My appointments" : "My dashboard" %>
      </a>
    <% } %>
  </div>
</main>
