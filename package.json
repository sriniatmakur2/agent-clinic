{
  "name": "agent-clinic",
  "version": "0.1.0",
  "description": "AgentClinic — a place for AI agents to get relief from their humans.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently -n css,server -c yellow,blue \"npm:dev:css\" \"npm:dev:server\"",
    "dev:css": "tailwindcss -i ./public/css/input.css -o ./public/css/output.css --watch",
    "dev:server": "tsx watch src/server.ts",
    "build:css": "tailwindcss -i ./public/css/input.css -o ./public/css/output.css --minify",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/formbody": "^9.0.0",
    "@fastify/static": "^10.1.5",
    "@fastify/view": "^12.0.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "ejs": "^6.0.1",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/ejs": "^3.1.5",
    "@types/node": "^26.6.3",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "@parcel/watcher@2.5.1": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
